{
  "name": "service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:test": "node scripts/dev-test.mjs",
    "start:company": "node scripts/start-company.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.mjs tests/api/*.test.mjs tests/flow/*.test.mjs",
    "test:unit": "node --test --test-concurrency=1 tests/unit/*.test.mjs",
    "test:api": "node --test --test-concurrency=1 tests/api/*.test.mjs tests/flow/*.test.mjs",
    "db:init": "node --env-file=.env.local scripts/init-db.mjs",
    "admin:password": "node --env-file=.env.local scripts/set-admin-password.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.25.0",
    "mysql2": "^3.23.1",
    "next": "16.2.10",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
